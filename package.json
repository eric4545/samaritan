{
  "name": "samaritan",
  "version": "1.0.0",
  "main": "dist/cli/index.js",
  "bin": {
    "samaritan": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "templates/",
    "README.md"
  ],
  "scripts": {
    "test": "tsx --test tests/**/*.test.ts",
    "test:e2e": "tsx --test tests/e2e/**/*.e2e.ts",
    "test:snapshots": "tsx --test tests/manuals/*.test.ts",
    "test:snapshots:update": "tsx --test --test-update-snapshots tests/manuals/*.test.ts",
    "build": "tsc && cp -r src/schemas dist/",
    "start": "tsx src/cli/index.ts",
    "prepare": "test -d dist || npm run build",
    "lint": "npx @biomejs/biome check .",
    "lint:fix": "npx @biomejs/biome check --write .",
    "docs:gen": "tsx scripts/gen-docs/index.ts --write",
    "docs:dev": "npm run docs:gen && vitepress dev docs",
    "docs:build": "npm run docs:gen && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eric4545/samaritan.git"
  },
  "keywords": [
    "operations",
    "sre",
    "automation",
    "yaml",
    "cli",
    "ops-as-code"
  ],
  "author": "SAMARITAN Team",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/eric4545/samaritan/issues"
  },
  "homepage": "https://eric4545.github.io/samaritan/",
  "description": "SAMARITAN - Operations as Code CLI for SRE teams. Define operations once, execute anywhere with complete audit trails.",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@atlaskit/adf-utils": "^19.24.0",
    "@types/node": "^24.3.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^14.0.0",
    "js-yaml": "^4.3.1",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/js-yaml": "^4.0.5",
    "tsx": "^4.22.3",
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "linkify-it": "^5.0.2",
    "fast-uri": "^3.1.4",
    "esbuild": "^0.25.0",
    "vite": "^6.4.3"
  }
}
